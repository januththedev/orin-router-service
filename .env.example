# Orin Router — environment template. NEVER commit real values.
# Vercel → Project → Settings → Environment Variables.

# Neon Postgres (pooled). Can be the SAME project as Orin core
# (router_* tables are namespaced). Run schema.sql once.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Orin session signing key (HS256, min 32 chars). MUST match the Orin core
# TOKEN_ENCRYPTION_KEY — the dashboard verifies the same session tokens.
TOKEN_ENCRYPTION_KEY=

# Master key for provider-credential encryption (AES-GCM, min 32 chars).
# Rotating it invalidates stored provider keys — re-save providers after.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROUTER_MASTER_KEY=

# Per-hop cooldown after retryable failures (ms). Default 60000.
ROUTER_COOLDOWN_MS=
