# Orin Router — deployment environment.
#
# Copy to deploy/oracle/router.env, fill every value, then:
#   chmod 600 deploy/oracle/router.env
#
# Never commit this file. Generate secrets with:
#   openssl rand -base64 32          # provider KEK
#   openssl rand -hex 32             # service signing key
#   openssl rand -hex 16             # cron secret

# --- Public identity ---------------------------------------------------------
# The DNS name that points at the Oracle VM. Caddy issues TLS for it.
ROUTER_HOST=router.orinai.org
ACME_EMAIL=you@orinai.org

# --- Database (Neon) ---------------------------------------------------------
# postgres://...sslmode=require  — pooler URL is fine and preferred.
DATABASE_URL=

# --- Redis (Upstash) ---------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any high-entropy string; namespaces Router keys inside the Redis database.
ORIN_ROUTER_REDIS_HASH_KEY=

# --- Core service authorization ---------------------------------------------
# The Router verifies Orin Core assertions with this shared secret and asks Core
# whether each assertion is still active.
ORIN_ROUTER_SERVICE_SIGNING_KEY=
ORIN_ROUTER_SERVICE_KEY_ID=
ORIN_CORE_CLIENT_ID=
ORIN_CORE_CLIENT_SECRET=
# Live mode pins introspection to https://orinai.org/api/auth/introspect and
# ignores this value. It is only read in fake mode, where it must be loopback.
ORIN_CORE_INTROSPECTION_URL=http://127.0.0.1:8081

# --- Provider credentials ----------------------------------------------------
# fake  = local fixtures, no outbound calls. Use this for a first boot.
# live  = real OpenRouter calls, free models only.
ORIN_PROVIDER_MODE=fake
# Platform fallback key. Optional: if every account brings its own BYOK key
# through the dashboard, this can stay empty and Router will fail closed
# rather than spend the platform's money.
ORIN_PROVIDER_API_KEY=
ORIN_ROUTER_CATALOG_SOURCE_URL=https://openrouter.ai/api/v1/models

# --- Provider key encryption -------------------------------------------------
# 32 raw bytes, base64. Rotating this makes existing stored keys unreadable
# unless the previous value is also supplied as ORIN_PROVIDER_KEK_PREVIOUS.
ORIN_PROVIDER_KEK_CURRENT=
ORIN_PROVIDER_KEK_PREVIOUS=

# --- Operational -------------------------------------------------------------
# Shared secret required by POST /api/internal/catalog/refresh.
CRON_SECRET=
# Per-account requests per minute.
ORIN_ROUTER_ACCOUNT_RPM=60
